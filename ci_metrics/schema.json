{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORI-C ci_metrics row schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "github_run_id": {
      "type": "string",
      "pattern": "^$|^[0-9]+$"
    },
    "run_dir_name": {
      "type": "string"
    },
    "dataset_id": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "run_mode": {
      "type": "string"
    },
    "evidence_strength": {
      "type": "string"
    },
    "all_pass": {
      "type": "string",
      "enum": [
        "",
        "True",
        "False",
        "true",
        "false"
      ]
    },
    "manifest_sha256": {
      "type": "string"
    },
    "stability_criteria_sha256": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "workflow_source": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "github_run_id",
    "run_dir_name",
    "dataset_id",
    "sector",
    "run_mode",
    "evidence_strength",
    "all_pass",
    "manifest_sha256",
    "stability_criteria_sha256",
    "commit_sha",
    "workflow_source"
  ]
}
