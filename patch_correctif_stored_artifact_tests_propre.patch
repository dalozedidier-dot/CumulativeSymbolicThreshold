+# These tests validate already-generated evidence artifacts under 05_Results/.
+# The active repository intentionally keeps 05_Results mostly empty; evidence
+# outputs are produced by proof/regeneration workflows and uploaded as CI
+# artifacts.  Therefore these checks must be opt-in, otherwise the ordinary
+# coverage gate fails for the wrong reason.
+_STORED_ARTIFACT_NODE_PATTERNS = (
+    "test_pilot_generalization.py::TestBenchmarkSummary",
+    "test_pilot_upgrade_registry.py::",
+    "test_power_upgrade_protocol.py::TestUpgradeReportOutputs",
+    "test_stored_artifacts_match_contracts.py::",
+)
+_RUN_STORED_ARTIFACT_TESTS = os.environ.get("ORIC_RUN_STORED_ARTIFACT_TESTS") == "1"
+
+
+def _requires_stored_artifacts(item: pytest.Item) -> bool:
+    nodeid = item.nodeid.replace("\\", "/")
+    return any(pattern in nodeid for pattern in _STORED_ARTIFACT_NODE_PATTERNS)
+
 
 def pytest_collection_modifyitems(config, items):
-    """Tag each collected test with its tier marker based on its module name."""
+    """Tag collected tests with tier markers and gate stored-artifact checks."""
     for item in items:
         stem = Path(str(item.fspath)).stem
         if stem in _SMOKE_MODULES:
             item.add_marker(pytest.mark.smoke)
         if stem in _SCIENTIFIC_MODULES:
             item.add_marker(pytest.mark.scientific)
+        if _requires_stored_artifacts(item):
+            item.add_marker(pytest.mark.stored_artifact)
+            if not _RUN_STORED_ARTIFACT_TESTS:
+                item.add_marker(
+                    pytest.mark.skip(
+                        reason=(
+                            "stored-artifact contract checks require generated "
+                            "05_Results; set ORIC_RUN_STORED_ARTIFACT_TESTS=1 "
+                            "inside a proof/regeneration workflow to enable them"
+                        )
+                    )
+                )
